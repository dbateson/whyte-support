{
  "name": "whyte-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-embed.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "admin:create": "node --experimental-strip-types scripts/create-admin.ts",
    "build:embed": "node scripts/build-embed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@supabase/storage-js": "^2.119.2",
    "@whyte/design-system": "file:vendor/whyte-design-system-0.22.0-51c3a7f.tgz",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "node-html-parser": "^7.1.0",
    "postal-mime": "^2.7.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
