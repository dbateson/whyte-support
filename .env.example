# Bootstrap configuration only. Every integration key (Anthropic, Voyage, Zoho,
# email, Shopify, Turnstile) is entered on the admin settings screen and stored
# encrypted in the database. Never add those here.

# Postgres connection string (Supabase: use the pooled "transaction" URL in production).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whyte_support

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Key rotation: add the new key as APP_ENCRYPTION_KEY and move the old one to
# APP_ENCRYPTION_KEY_PREVIOUS, bump APP_ENCRYPTION_KEY_VERSION, then run the re-encrypt job.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1
APP_ENCRYPTION_KEY_PREVIOUS=
